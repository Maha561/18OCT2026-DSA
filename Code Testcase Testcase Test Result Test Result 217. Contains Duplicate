class Solution {
    public boolean containsDuplicate(int[] nums) {
        

       
      int  count = 0;

      

       for(int i =0;i<nums.length;i++){

        int value = nums[i];

        for(int j=0;j<nums.length;j++){


            if(nums[j]==value){

                count++;
            }
        }

        if(count==2){

            return true;
           
        }
        else{

            count=0;
        }



       }

       return false;
    }
}
